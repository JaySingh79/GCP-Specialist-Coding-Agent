# Google Gemini API Key (Required for Agent reasoning and Interactions)
GEMINI_API_KEY=your_gemini_api_key_here

# Tavily API Key (Required for live web research / verification)
TAVILY_API_KEY=your_tavily_api_key_here

# Optional: OpenRouter / HuggingFace tokens for ancillary model tools
OPENROUTER_API_KEY=your_openrouter_api_key_here
HF_TOKEN=your_huggingface_token_here
